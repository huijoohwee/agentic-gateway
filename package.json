{
  "name": "agentic-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local capability discovery and invocation with native adapters",
  "exports": {
    ".": "./resolver.mjs",
    "./presets": "./presets.mjs",
    "./catalog/index.json": "./catalog/index.json",
    "./catalog/pin.json": "./catalog/pin.json",
    "./catalog/bodies/*.txt": "./catalog/bodies/*.txt",
    "./connectors/moomoo-quote-socket": "./connectors/moomoo-quote-socket.mjs",
    "./connectors/moomoo-trade-event": "./connectors/moomoo-trade-event.mjs",
    "./connectors/moomoo-securities-history": "./connectors/moomoo-securities-history.mjs",
    "./connectors/moomoo-watchlist": "./connectors/moomoo-watchlist.mjs",
    "./connectors/moomoo-market-rest": "./connectors/moomoo-market-rest.mjs",
    "./connectors/moomoo-stock-screen": "./connectors/moomoo-stock-screen.mjs",
    "./connectors/moomoo": "./connectors/moomoo.mjs",
    "./connectors/hyperframes": "./connectors/hyperframes.mjs",
    "./connectors/moomoo-opend.py": "./connectors/moomoo-opend.py",
    "./examples/hyperframes/cards.html": "./qualification/hyperframes/index.html",
    "./provider-profiles": "./provider-profiles.mjs",
    "./examples/hyperframes/open-studio.html": "./qualification/hyperframes/open-studio/index.html",
    "./connectors/moomoo-coverage": "./connectors/moomoo-coverage.mjs",
    "./connectors/moomoo-catalog.json": "./connectors/moomoo-catalog.json",
    "./connectors/moomoo-fields.json": "./connectors/moomoo-fields.json",
    "./transfer/browser-files": {
      "types": "./transfer/browser-files.d.mts",
      "default": "./transfer/browser-files.mjs"
    },
    "./transfer/copied-page": {
      "types": "./transfer/copied-page.d.mts",
      "default": "./transfer/copied-page.mjs"
    },
    "./transfer/record-export": {
      "types": "./transfer/record-export.d.mts",
      "default": "./transfer/record-export.mjs"
    }
  },
  "files": [
    "resolver.mjs",
    "vendor/agentic-base",
    "README.md",
    "presets.mjs",
    "catalog",
    "connectors",
    "qualification/hyperframes/index.html",
    "provider-profiles.mjs",
    "qualification/hyperframes/open-studio/index.html",
    "transfer"
  ],
  "scripts": {
    "test": "node --test test/resolver.test.mjs test/presets.test.mjs test/provider-connectors.test.mjs test/stock-screen.test.mjs test/market-rest.test.mjs test/ark.test.mjs test/ipo.test.mjs test/trade-event.test.mjs test/securities-history.test.mjs test/quote-socket.test.mjs test/transfer.test.mjs",
    "setup": "agentic-os setup",
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "land": "agentic-os land",
    "successor": "agentic-os successor",
    "release:common": "agentic-os release-common",
    "sync:canonical": "agentic-os canonical-sync",
    "presets:build": "node tools/project-presets.mjs",
    "presets:check": "node tools/project-presets.mjs --check",
    "pretest": "npm run presets:check"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huijoohwee/agentic-gateway.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@agentic-base/views-react": "https://codeload.github.com/huijoohwee/agentic-base/tar.gz/7b2d45d8e5ae867b4dba4be1ebe043d268c5042b",
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/f5cca6b1cd0d7bd16a0dd57abba35996262c481f",
    "js-yaml": "4.3.2"
  }
}
